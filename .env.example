# Copy to .env.local for local development, or let `npx convex dev` write it.
#
# VITE_CONVEX_URL         — the deployment the browser talks to. Public; inlined
#                           into the bundle by Vite. Required.
# CONVEX_DEPLOYMENT       — which deployment the Convex CLI acts on. Written
#                           automatically by `npx convex dev`.
# VITE_GA_MEASUREMENT_ID  — GA4 measurement ID. Optional: leave it unset locally
#                           so analytics stays inert during development.
VITE_CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_DEPLOYMENT=dev:your-deployment
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
