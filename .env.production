# ⚠️ PUBLIC VALUES ONLY. Vite inlines every VITE_* variable into the client
# bundle, so nothing secret can live in this file. It is tracked in git on
# purpose, so a fresh clone can build and deploy without extra setup.

# Convex deployment the production build talks to.
#
# ⚠️ This currently points at a *development* deployment. Before real launch
# traffic, provision a production deployment and swap this URL for it.
VITE_CONVEX_URL=https://veracious-viper-240.eu-west-1.convex.cloud

# GA4 measurement ID. One property covers both domains — at the move to .com we
# keep this ID and edit the stream URL in the GA4 admin instead.
VITE_GA_MEASUREMENT_ID=G-HJBJYG9743
